{
  "name": "solana-program-byte-verifier",
  "version": "0.1.0",
  "description": "Verify local and deployed Solana program binaries byte-for-byte.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "spbv": "./dist/src/cli.js" },
